# ============================================================
# Pravah AI — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- OpenRouter API Keys (multi-key pool) ---
# Both keys share the same primary model and load-balance automatically.
OPENROUTER_API_KEY_1=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_2=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# Optional fallback key or additional keys (3, 4, 5)
# OPENROUTER_API_KEY_3=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_FALLBACK_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# --- Model Configuration (optional — defaults shown) ---
# Primary model: Google's Gemma 3 27B, reliable and free on OpenRouter.
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Fallback: OpenRouter's auto-router picks whichever free model is alive.
OPENROUTER_FALLBACK_MODEL=openrouter/free

# --- Other LLM Providers (optional, used if OpenRouter keys not set) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...

# --- Pravah Cloud Browser Provider (optional) ---
# PRAVAH_CLOUD_API_KEY=...

# --- Debug / Tracing (optional, set to 1 to enable) ---
# PRAVAH_TRACE_WAIT=0
# PRAVAH_DEBUG_STRUCTURED_SCHEMA=0
# PRAVAH_PROFILE_DOM=0
